# Plantilla de configuracion local. Copiala como ".env" en esta misma carpeta
# y llena los valores. El .env NO se sube al repositorio; este archivo si.

# Clave propia de cada integrante. Generala con:
#   ..\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcion A: base en la nube (Supabase). Pide la cadena al equipo por un medio
# privado, nunca por el repositorio. Si esta definida, se ignoran las DB_*.
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres?sslmode=require

# Opcion B: PostgreSQL instalado en tu equipo.
DB_NAME=monitoreo
DB_USER=adminsistema
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
